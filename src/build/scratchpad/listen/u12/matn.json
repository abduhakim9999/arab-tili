{
 "raqam_uz": "Oʻn ikkinchi dars.",
 "gaplar_uz": {
  "1": "Sizga omonlik boʻlsin!",
  "2": "Sizga ham omonlik boʻlsin! Nima xizmat?",
  "3": "Menga ayrim mebellar kerak.",
  "4": "Yotoqxona uchun sizga nima kerak?",
  "5": "Menga karavot va parda kerak.",
  "6": "Zal, mehmon kutish xonasi, uchun-chi, sizga nima kerak?",
  "7": "Menga divan va gilam kerak.",
  "8": "Oshxona uchun-chi, sizga nima kerak?",
  "9": "Menga pech va muzlatgich, xolodilnik, kerak.",
  "10": "Hammom, vanna, uchun-chi, sizga nima kerak?",
  "11": "Menga kotyol, isitgich, va oyna, koʻzgu, kerak. Mebellarni koʻrishni istayman.",
  "12": "Marhamat, koʻring!"
 },
