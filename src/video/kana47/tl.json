 "subs": [
  [
   0.3,
   3.46,
   "Bir mo'ysafid har kecha Qur'on o'qir edi."
  ],
  [
   3.46,
   9.09,
   "Arabchada bu ham kaana bilan aytiladi, lekin yonida yana bir fe'l turadi."
  ],
  [
   9.09,
   10.09,
   "Qanday qilib?"
  ],
  [
   10.09,
   11.4,
   "Oxirida ko'ramiz."
  ],
  [
   12.15,
   14.85,
   "Avval kaananing muzoriysi: yakuunu."
  ],
  [
   14.85,
   16.85,
   "U ham noqis — fo'ili yo'q."
  ],
  [
   16.85,
   22.09,
   "Mubtadoni ismi qilib, raf qiladi; xabarni xabari qilib, nasb qiladi."
  ],
  [
   22.09,
   23.79,
   "Tarjimasi — «bo'ladi»."
  ],
  [
   26.57,
   32.31,
   "Sodda qilib aytsak: kaana — kecha haqida, yakuunu — bugun va ertaga haqida."
  ],
  [
   32.31,
   33.15,
   "Hukm o'sha."
  ],
  [
   33.95,
   36.9,
   "Yakuunu boshidagi «ya» — muzoraat harfi."
  ],
  [
   36.9,
   40.52,
   "Ismi muannas bo'lsa, u «ta»ga almashadi: takuunu."
  ],
  [
   40.82,
   43.32,
   "(арабчаси ҳақиқий овозда ўқилади)"
  ],
  [
   44.22,
   47.6,
   "Savol uchun oldidan «hal» yoki hamza keladi."
  ],
  [
   47.6,
   51.97,
   "Tarkibda: noqis muzoriy fe'li, ismi — raf, xabari — nasb."
  ],
  [
   51.97,
   54.58,
   "Savol gap — jumlatun istifhomiyya."
  ],
  [
   54.88,
   57.58,
   "(арабчаси ҳақиқий овозда ўқилади)"
  ],
  [
   58.53,
   63.67,
   "Ismi ikkita bo'lsa, raf alomati — alif, muzakkar solim jamda — vov."
  ],
  [
   63.67,
   65.82,
   "Yakuunu esa birlikda qoladi."
  ],
  [
   66.12,
   69.12,
   "(арабчаси ҳақиқий овозда ўқилади)"
  ],
  [
   70.12,
   73.34,
   "Inkor uchun «laa» qo'shiladi: «bo'lmaydi»."
  ],
  [
   73.34,
   78.94,
   "Javobdagi birinchi «laa» — «yo'q», javob harfi, ikkinchisi — nafiy harfi."
  ],
  [
   78.94,
   81.47,
   "Bu darak gap: jumlatun xabariyya."
  ],
  [
   81.77,
   85.97,
   "(арабчаси ҳақиқий овозда ўқилади)"
  ],
  [
   87.02,
   91.83,
   "Aqlsiz muannas ko'plikda xabar ikki xil keladi, ikkalasi ham joiz."
  ],
  [
   92.13,
   94.63,
   "(арабчаси ҳақиқий овозда ўқилади)"
  ],
  [
   95.68,
   97.13,
   "Endi boshidagi sir."
  ],
  [
   97.13,
   103.7,
   "Kaananing xabari muzoriy fe'l bo'lsa, «qilar edi» chiqadi: o'tmishda takrorlangan ish."
  ],
  [
   103.7,
   110.2,
   "Xabar — butun jumla, shuning uchun fe'l oxiri o'zgarmaydi: jumla nasb o'rnida turadi."
  ],
  [
   110.5,
   114.8,
   "(арабчаси ҳақиқий овозда ўқилади)"
  ],
  [
   115.35,
   119.62,
   "Qur'onda Ismoil alayhissalom haqida ham shunday deyilgan:"
  ],
  [
   131.47,
   134.2,
   "Ahlini namoz va zakotga buyurar edi."
  ],
  [
   134.2,
   139.38,
   "Farqini eslang: yakuunu — «bo'ladi», kaana va muzoriy — «qilar edi»."
  ],
  [
   140.43,
   142.59,
   "Xulosa: yakuunu — «bo'ladi»."
  ],
  [
   142.59,
   147.62,
   "Ismi raf, xabari nasb, muannasda — takuunu, inkori — laa yakuunu."
  ],
  [
   147.62,
   151.49,
   "Endi sinab ko'ring: «Ikki muallima olima bo'ladi»."
  ],
  [
   151.49,
   152.65,
   "Qaysi biri mos?"
  ],
  [
   154.95,
   158.05,
   "(арабчаси ҳақиқий овозда ўқилади)"
  ],
  [
   158.45,
   161.11,
   "To'g'ri: «ta» va «ya» bilan."
  ],
  [
   161.11,
   163.29,
   "Keyingi video: 48-dars."
  ]
 ]
}