 "subs": [
  [
   1.1,
   6.8,
   "O'tgan videoda kaana gap boshiga keldi-yu, «jamiylun» «jamiylan» bo'lib qoldi."
  ],
  [
   6.8,
   7.17,
   "Nega?"
  ],
  [
   21.1,
   25.13,
   "Kaana gapga kirib keladi va ikkalasiga ham hukm qiladi."
  ],
  [
   25.13,
   29.97,
   "Mubtadoga: «Raf bo'l!» Mubtado jilmayadi: «Men allaqachon rafman»."
  ],
  [
   29.97,
   34.14,
   "Oxiri o'zgarmaydi, faqat yangi nom oladi: kaananing ismi."
  ],
  [
   34.14,
   40.16,
   "Xabarga esa: «Oxiringni o'zgartir!» Xabar bo'ysunadi: zammani qo'yib, fatha oladi."
  ],
  [
   40.16,
   42.87,
   "Endi u kaananing xabari, holati nasb."
  ],
  [
   43.17,
   48.98,
   "Lekin ism ham jim qolmaydi: kerak bo'lsa, kaananing o'zini o'zgartirib qo'yadi."
  ],
  [
   48.98,
   49.93,
   "Qanday qilib?"
  ],
  [
   49.93,
   51.7,
   "Birozdan keyin ko'ramiz."
  ],
  [
   69.0,
   73.32,
   "Bitta nozik joy: Alloh haqida «edi» emas, «doimo» deyiladi."
  ],
  [
   73.32,
   76.55,
   "Bu ma'no kaanadan emas, gap egasidan keladi."
  ],
  [
   76.85,
   79.85,
   "(арабчаси ҳақиқий овозда ўқилади)"
  ],
  [
   119.58,
   124.9,
   "E'tibor bering: ismi ikkita yoki ko'p bo'lsa ham, kaana birlikda turibdi."
  ],
  [
   124.9,
   128.19,
   "U ismiga faqat jinsda moslashadi, sonda emas."
  ],
  [
   129.24,
   136.7,
   "Aqlsiz narsalar ko'pligida esa xabar oldingi darslardagidek muannas birlikda keladi, faqat endi nasbda."
  ],
  [
   137.0,
   139.3,
   "(арабчаси ҳақиқий овозда ўқилади)"
  ],
  [
   140.35,
   144.88,
   "Inkor uchun kaana oldidan «maa» qo'yamiz: «bo'lmadi, emas edi»."
  ],
  [
   148.25,
   151.42,
   "Xulosa: kaana kelsa, ismi raf, xabari nasb."
  ],
  [
   151.42,
   154.23,
   "Ismi muannas bo'lsa, kaana «ta» oladi."
  ],
  [
   154.23,
   157.48,
   "Endi sinab ko'ring: «Ikki toliba katta edi»."
  ],
  [
   157.48,
   158.59,
   "Qaysi biri mos?"
  ],
  [
   160.89,
   163.99,
   "(арабчаси ҳақиқий овозда ўқилади)"
  ],
  [
   164.39,
   168.46,
   "To'g'ri, «ya» bilan: ikkilikda nasb alomati shu."
  ],
  [
   168.46,
   170.4,
   "Keyingi video: 47-dars."
  ]
 ]
}