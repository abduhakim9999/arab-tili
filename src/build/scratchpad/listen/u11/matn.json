{
 "raqam_uz": "Oʻn birinchi dars.",
 "gaplar_uz": {
  "1": "Sizga omonlik boʻlsin!",
  "2": "Sizga ham omonlik boʻlsin!",
  "3": "Iltimos, menga kvartira kerak.",
