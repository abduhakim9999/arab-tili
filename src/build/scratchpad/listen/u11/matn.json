   "uz": "Qavat."
  },
  {
   "i": 10,
   "ar": "شَاهَدَ، يُشَاهِدُ، شَاهِدْ، مُشَاهَدَتُنْ",
   "uz": "Koʻrmoq, tomosha qilmoq."
  },
  {
   "i": 11,
   "ar": "تَفَضَّلَ، يَتَفَضَّلُ، تَفَضَّلْ، تَفَضُّلُنْ",
   "uz": "Marhamat qilmoq."
  }
 ]
