َرَبَ", "mu": "يَقْتَرِبُ", "me": "яқинлашди"}, {"m": "رَأَى", "mu": "يَرَى", "me": "кўрди маъқул кўрди"}, {"m": "رَجَعَ", "mu": "يَرْجِعُ", "me": "қайтди"}, {"m": "حَجَّ", "mu": "يَحُجُّ", "me": "ҳаж қилди"}, {"m": "سَاعَدَ", "mu": "يُسَاعِدُ", "me": "ёрдам берди"}, {"m": "عَالَجَ", "mu": "يُعَالِجُ", "me": "даволади, тузатди"}, {"m": "اِشْتَكَى", "mu": "يَشْتَكِي", "me": "шикоят қилди"}, {"m": "سَقَى", "mu": "يَسْقِي", "me": "ичирди"}, {"m": "أَمَرَ", "mu": "يَأْمُرُ", "me": "буюрди, амр қилди"}, {"m": "وَجَدَ", "mu": "يَجِدُ", "me": "топди кўрди"}, {"m": "بَاعَ", "mu": "يَبِيعُ", "me": "сотди"}, {"m": "اِشْتَرَى", "mu": "يَشْتَرِي", "me": "сотиб олди"}, {"m": "فَكَّرَ", "mu": "يُفَكِّرُ", "me": "ўйлади, фикр юритди"}, {"m": "تَشَابَهَ", "mu": "يَتَشَابَهُ", "me": "бир-бирига (ўзаро) ўхшади"}, {"m": "اِخْتَلَفَ", "mu": "يَخْتَلِفُ", "me": "бир-биридан фарқ қилди ҳар хил (турлича) бўлди"}, {"m": "زَادَ", "mu": "يَزِيدُ", "me": "зиёда қилди; зиёда бўлди"}, {"m": "وَجَبَ", "mu": "يَجِبُ", "me": "шарт (керак) бўлди"}, {"m": "حَاوَلَ", "mu": "يُحَاوِلُ", "me": "тиришди, ҳаракат қилди, уринди"}, {"m": "نَجَحَ", "mu": "يَنْجَحُ", "me": "муваффақиятга эришди; (имтиҳондан) ўтди"}, {"m": "أَخَذَ", "mu": "يَأْخُذُ", "me": "олди"}, {"m": "أَخَذَ ...", "mu": "", "me": "...а бошлади (афъолуш шуруъ – бошлаш феъллари)"}, {"m": "ظَلَّ ...", "mu": "", "me": "...ча қолди, ...ликда давом этди"}, {"m": "نَقَصَ", "mu": "يَنْقُصُ", "me": "камайди"}, {"m": "جَرَى", "mu": "يَجْرِي", "me": "югурди"}, {"m": "اِتَّبَعَ", "mu": "يَتَّبِعُ", "me": "риоя қилди"}, {"m": "اِعْتَقَدَ", "mu": "يَعْتَقِدُ", "me": "1. амин бўлди, қаттиқ ишонди 2. ўйлади"}, {"m": "كَفَى", "mu": "يَكْفِي", "me": "кифоя қилди, етарли бўлди"}, {"m": "أَحْسَنَ", "mu": "يُحْسِنُ", "me": "яхшилик қилди"}, {"m": "أُغْمِيَ عَلَيْهِ", "mu": "", "me": "у(мз) ҳушидан кетиб қолди"}, {"m": "أَفَاقَ", "mu": "يُفِيقُ", "me": "ҳушига келди"}, {"m": "غَيَّرَ", "mu": "يُغَيِّرُ", "me": "ўзгартирди"}, {"m": "قَصَدَ", "mu": "يَقْصِدُ", "me": "1. назарда тутди"}, {"m": "صَدَقَ", "mu": "يَصْدِقُ", "me": "тўғри айтди, тўғри гапирди"}, {"m": "رَوَّحَ", "mu": "يُرَوِّحُ", "me": "عَنْ.. — ..га дам берди"}, {"m": "اِحْتَاجَ", "mu": "يَحْتَاجُ", "me": "إِلَى.. — ...га муҳтож бўлди, эҳтиёж сезди"}, {"m": "قَتَلَ", "mu": "يَقْتُلُ", "me": "1. ўлдирди 2. зое қилди, совурди"}, {"m": "صَادَ", "mu": "يَصِيدُ", "me": "тутди, (балиқ) овлади"}, {"m": "رَضِيَ", "mu": "يَرْضَى", "me": "عَنْ.. — ...дан рози бўлди"}, {"m": "عَلَّمَ", "mu": "يُعَلِّمُ", "me": "ўргатди"}, {"m": "نَادَى", "mu": "يُنَادِي", "me": "чақирди"}, {"m": "نَاقَشَ", "mu": "يُنَاقِشُ", "me": "муҳокама қилди"}, {"m": "لَعِبَ", "mu": "يَلْعَبُ", "me": "ўйнади"}, {"m": "سَبَحَ", "mu": "يَسْبَحُ", "me": "(сувда) сузди"}, {"m": "عَرَفَ", "mu": "يَعْرِفُ", "me": "1. билди 2. таниди"}, {"m": "عَادَ", "mu": "يُعُودُ", "me": "қайтди إِلَى.. — ...га бориб тақалди"}, {"m": "خَيَّمَ", "mu": "يُخَيِّمُ", "me": "чодир тикди, лагерь ташкил қилди"}, {"m": "أَعَدَّ", "mu": "يُعِدُّ", "me": "тайёрлади"}, {"m": "نَصَبَ", "mu": "يَنْصِبُ", "me": "ўрнатди"}, {"m": "حَمَلَ", "mu": "يَحْمِلُ", "me": "олиб борди"}, {"m": "اِصْطَادَ", "mu": "يَصْطَادُ", "me": "овлади, тутди"}, {"m": "صَوَّرَ", "mu": "يُصَوِّرُ", "me": "расм чизди; суратга олди"}, {"m": "مَشَى", "mu": "يَمْشِي", "me": "юрди; яёв юрди"}, {"m": "اِتَّفَقَ", "mu": "يَتَّفِقُ", "me": "келишди, келишиб олди"}, {"m": "حَقَّقَ", "mu": "يُحَقِّقُ", "me": "рўёбга чиқарди"}, {"m": "تَرِبَ", "mu": "يَتْرَبُ", "me": "тупроққа қоришди"}, {"m": "ظَفِرَ", "mu": "يَظْفَرُ", "me": "بِـ.. — ..га эришди, ..ни қўлга киритди"}, {"m": "حَلَّ", "mu": "يَحِلُّ", "me": "ечди, ҳал қилди"}, {"m": "وَقَعَ", "mu": "يَقَعُ", "me": "содир бўлди, келиб чиқди жойлашди"}, {"m": "ظَهَرَ", "mu": "يَظْهَرُ", "me": "кўриниб қолди, намоён бўлди 3. пайдо бўлди, юзага келди"}, {"m": "عَجَزَ", "mu": "يَعْجِزُ", "me": "ожиз бўлди, қодир бўлмади, ..а олмади"}, {"m": "ثَارَ", "mu": "يَثُورُ", "me": "қизишиб кетди, лов этиб ёнди"}, {"m": "شَكَا", "mu": "يَشْكُو", "me": "шикоят қилди"}, {"m": "اِسْتَمَعَ", "mu": "يَسْتَمِعُ", "me": "إِلَى، لِـ — ..га қулоқ солди, ..ни тинглади"}, {"m": "عَاشَ", "mu": "يَعِيشُ", "me": "яшади, кун кечирди"}, {"m": "دَرَى", "mu": "يَدْرِي", "me": "билди"}, {"m": "تَغَيَّرَ", "mu": "يَتَغَيَّرُ", "me": "ўзгарди"}, {"m": "اِهْتَمَّ", "mu": "يَهْتَمُّ", "me": "بِـ.. — ...га эътибор (аҳамият) берди"}, {"m": "سَهِرَ", "mu": "يَسْهَرُ", "me": "1. кечани (тунни) ўтказди"}, {"m": "تَكَوَّنَ", "mu": "يَتَكَوَّنُ", "me": "таркиб топди, тузилди"}, {"m": "قَامَ", "mu": "يَقُومُ", "me": "بِـ... — ..ни бажарди (қилди, амалга оширди), ..ни адо этди"}, {"m": "اِخْتَفَى", "mu": "يَخْتَفِي", "me": "1. йўқ бўлиб кетди"}, {"m": "ضَمَّ", "mu": "يَضُمُّ", "me": "1. (ўзида) жамлади, мужассам этди"}, {"m": "جَلَسَ", "mu": "يَجْلِسُ", "me": "ўтирди"}, {"m": "رَحَلَ", "mu": "يَرْحَلُ", "me": "кетди, йўлга отланди"}, {"m": "مَاتَ", "mu": "يَمُوتُ", "me": "ўлди, нобуд бўлди"}, {"m": "حَيِيَ", "mu": "يَحْيَا", "me": "яшади, ҳаёт кечирди"}, {"m": "هَاجَرَ", "mu": "يُهَاجِرُ", "me": "кўчиб ўтди, кўчиб кетди"}, {"m": "وَاجَهَ", "mu": "يُوَاجِهُ", "me": "дуч келди"}, {"m": "اِزْدَادَ", "mu": "يَزْدَادُ", "me": "зиёда бўлди, кўпайди"}, {"m": "أَدْرَكَ", "mu": "يُدْرِكُ", "me": "1. етди 2. англаб етди"}, {"m": "بَنَى", "mu": "يَبْنِي", "me": "қурди, бино қилди"}, {"m": "بَلَغَ", "mu": "يَبْلُغُ", "me": "етди"}, {"m": "اِتَّجَهَ", "mu": "يَتَّجِهُ", "me": "йўл олди"}, {"m": "اِنْعَطَفَ", "mu": "يَنْعَطِفُ", "me": "бурилди"}, {"m": "اِسْتَمَرَّ", "mu": "يَسْتَمِرُّ", "me": "давом этди"}, {"m": "اِشْتَهَرَ", "mu": "يَشْتَهِرُ", "me": "...ни машҳур қилди"}, {"m": "كَثُرَ", "mu": "يَكْثُرُ", "me": "кўп бўлди; кўпайди"}, {"m": "أَنْشَأَ", "mu": "يُنْشِئُ", "me": "қурди; ташкил қилди"}, {"m": "قَدَّمَ", "mu": "يُقَدِّمُ", "me": "тақдим қилди, топширди"}, {"m": "قَبِلَ", "mu": "يَقْبَلُ", "me": "қабул қилди"}, {"m": "رَغِبَ", "mu": "يَرْغَبُ", "me": "فِي... — ..ни истади, ..га қизиқди"}, {"m": "حَصَلَ", "mu": "يَحْصُلُ", "me": "عَلَى.. — ..ни қўлга киритди, ..га эришди, ...ни олди"}, {"m": "اِلْتَحَقَ", "mu": "يَلْتَحِقُ", "me": "بِـ... — ..га кирди, қабул қилинди"}, {"m": "وَافَقَ", "mu": "يُوَافِقُ", "me": "عَلَى... — ...га рози бўлди"}, {"m": "وَفَّقَ", "mu": "يُوَفِّقُ", "me": "... فِي ... — ..ни ..га муваффақ қилди, ...га ...ни насиб этди"}, {"m": "تَعَلَّمَ", "mu": "يَتَعَلَّمُ", "me": "1. таълим олди"}, {"m": "اِنْتَشَرَ", "mu": "يَنْتَشِرُ", "me": "1. ёйилди, кенг тарқалди"}, {"m": "شَاعَ", "mu": "يَشِيعُ", "me": "1. кенг тарқалди, оммалашди, машҳур бўлди"}, {"m": "سَارَ", "mu": "يَسِيرُ", "me": "юрди"}, {"m": "تَقَدَّمَ", "mu": "يَتَقَدَّمُ", "me": "2. пешқадам (илғор) бўлди"}, {"m": "تَأَثَّرَ", "mu": "يَتَأَثَّرُ", "me": "بِـ.. — 1. ..дан таъсирланди, ..га ..нинг таъсири бўлди"}, {"m": "اِتَّصَلَ", "mu": "يَتَّصِلُ", "me": "بِـ.. — 1. ... билан (..га) боғланди"}, {"m": "تَرْجَمَ", "mu": "يُتَرْجِمُ", "me": "1. таржима қилди"}, {"m": "تَأَخَّرَ", "mu": "يَتَأَخَّرُ", "me": "2. ортда қолди"}, {"m": "نَزَلَ", "mu": "يَنْزِلُ", "me": "1. тушди, нозил бўлди"}, {"m": "مَرَّ", "mu": "يَمُرُّ", "me": "بِـ.. — 1. ..дан ўтди"}, {"m": "أَنْهَى", "mu": "يُنْهِي", "me": "тугатди"}, {"m": "تَرَاوَحَ", "mu": "يَتَرَاوَحُ", "me": "тебранди, ..дан ..гача бўлди"}, {"m": "أَشْرَفَ", "mu": "يُشْرِفُ", "me": "عَلَى .. — 1. ..ни бошқарди"}, {"m": "وَفَّرَ", "mu": "يُوَفِّرُ", "me": "1. таъминлади (..ни берди)"}]